rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOffice() {
      return signedIn()
        && (request.auth.token.role == 'admin' || request.auth.token.role == 'auxiliar');
    }

    match /models/images/{imageId} {
      allow read: if true;
      allow write: if isOffice();
    }

    match /projects/{allPaths=**} {
      allow read: if signedIn();
      allow write: if isOffice();
    }
  }
}
